{
  "name": "@acunsoft/acun-ui",
  "version": "2.5.0",
  "private": true,
  "description": "Acun UI: the design tokens, Tailwind CSS v4 sources, compiled stylesheet and browser runtime of the Composer package acunsoft/acun-ui (Laravel + Livewire). Not on npm: the application installs it from its Composer copy, \"file:vendor/acunsoft/acun-ui\".",
  "homepage": "https://docs.acunui.com",
  "keywords": [
    "tailwindcss",
    "alpinejs",
    "livewire",
    "laravel",
    "admin",
    "dashboard",
    "ui-kit",
    "components"
  ],
  "license": "MIT",
  "author": "Acunsoft",
  "type": "module",
  "style": "./css/panel.css",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "style": "./css/panel.css",
      "default": "./js/index.js"
    },
    "./css/*": "./css/*",
    "./js/*": {
      "types": "./types/*",
      "default": "./js/*"
    },
    "./vite": "./vite/index.js"
  },
  "sideEffects": [
    "**/*.css",
    "./js/index.js",
    "./js/boot.js"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "swiper": "14.3.0"
  },
  "peerDependencies": {
    "tailwindcss": "^4.1.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  }
}
