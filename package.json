{
  "name": "@acunsoft/acun-ui",
  "version": "2.2.0",
  "description": "Acun UI: design tokens, Tailwind CSS v4 sources, a compiled stylesheet and the browser runtime of the Acun UI components.",
  "homepage": "https://ui.acunsoft.com",
  "keywords": [
    "tailwindcss",
    "alpinejs",
    "livewire",
    "laravel",
    "admin",
    "dashboard",
    "ui-kit",
    "components"
  ],
  "license": "MIT",
  "author": "Acunsoft",
  "type": "module",
  "style": "./css/panel.css",
  "jsdelivr": "./dist/acun-ui.js",
  "unpkg": "./dist/acun-ui.js",
  "exports": {
    ".": {
      "style": "./css/panel.css",
      "default": "./js/index.js"
    },
    "./acun-ui.css": "./dist/acun-ui.css",
    "./acun-ui-core.css": "./dist/acun-ui-core.css",
    "./css/*": "./css/*",
    "./js/*": "./js/*",
    "./vite": "./vite/index.js"
  },
  "files": [
    "css",
    "js",
    "dist",
    "vite",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css",
    "./js/index.js",
    "./js/boot.js"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "prepublishOnly": "node --test tests/js/assets.test.mjs tests/js/css-dist.test.mjs"
  },
  "peerDependencies": {
    "tailwindcss": "^4.1.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
