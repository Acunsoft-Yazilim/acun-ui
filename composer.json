{
    "name": "acunsoft/acun-ui",
    "description": "Acun UI for Laravel, free: Blade and Livewire components (<acun:*>), the Tailwind CSS theme and the Alpine.js runtime in one package. npm takes the CSS and JS from the Composer copy: \"@acunsoft/acun-ui\": \"file:vendor/acunsoft/acun-ui\". The panel layouts and menu, the paid components, form modals and e-commerce are in acunsoft/acun-pro.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/auth": "^12.0 || ^13.0",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/process": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/view": "^12.0 || ^13.0",
        "laravel/prompts": "^0.3",
        "livewire/livewire": "^4.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "replace": {
        "acunsoft/acun-ui-core": "self.version",
        "acunsoft/acun-ui-free": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Acun\\Ui\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Acun\\Ui\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Acun\\Ui\\AcunUiServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
